{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=matchmaking;Username=matchmaking;Password=matchmaking",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=5000,syncTimeout=5000,asyncTimeout=5000"
  },
  "Matchmaking": {
    "WorkerIntervalMs": 500,
    "ShardLockSeconds": 5,
    "MaxQueueDepth": 10000,
    "MatchCandidateLimit": 200,
    "SeedRegions": [ "eu", "na", "asia" ]
  }
}
